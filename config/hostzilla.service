[Unit]
Description=Hostzilla control panel (gunicorn)
Documentation=https://github.com/hostzilla/hostzilla
# MySQL is required for site provisioning; wait for the network + DB to come up.
After=network.target mysql.service
Wants=network.target

[Service]
Type=simple
User=hostzilla
Group=hostzilla
WorkingDirectory=/opt/hostzilla/panel
# Read operator config (PANEL_PORT etc.) so admins can retune without editing the unit.
EnvironmentFile=-/etc/hostzilla/hostzilla.conf
ExecStart=/opt/hostzilla/panel/venv/bin/gunicorn -w 4 -b 127.0.0.1:2087 wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

# --- Hardening (panel is unprivileged; it only escalates via the sudoers allowlist) ---
# NB: the privileged provisioning runner (invoked via sudo) inherits this service's
# mount namespace, so every path the runner WRITES must be reachable here or it
# fails with "Read-only file system". The runner provisions across /etc and /var/www
# and writes the per-site PHP-FPM socket under /run/php that the system Apache/PHP-FPM
# (outside this namespace) must also see — hence PrivateTmp is OFF and the runner's
# write targets are listed in ReadWritePaths.
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=false
# Writable state: the SQLite DB, panel logs, AND everything the runner provisions:
#   /etc/hostzilla/sites (manifests), /etc/apache2 (vhosts), /etc/php (FPM pools),
#   /var/www (docroots), /run/php (FPM sockets).
ReadWritePaths=/var/lib/hostzilla /var/log/hostzilla /etc/hostzilla /etc/apache2 /etc/php /var/www /run/php

[Install]
WantedBy=multi-user.target
